{:paths ["src" "resources"]

 ;; Your plugin's own runtime dependencies go here.
 ;; Do NOT add Clojure here — it is provided at runtime by LithClojureRuntime.
 :deps {}

 :mvn/repos {"papermc" {:url "https://repo.papermc.io/repository/maven-public/"}}

 :aliases
 {;; Clojure + Paper API are compile-time only — both are provided at runtime
  :compile
  {:extra-deps {org.clojure/clojure          {:mvn/version "1.12.0"}
                io.papermc.paper/paper-api   {:mvn/version "1.21.4-R0.1-SNAPSHOT"}}}

  :build
  {:deps {io.github.clojure/tools.build {:git/tag "v0.10.5" :git/sha "2a21b7a"}}
   :ns-default build}}}
